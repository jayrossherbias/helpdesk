SECRET_KEY=your-secret-key
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Gmail SMTP — use a Google App Password (NOT your real Gmail password)
# See: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
FRONTEND_URL=http://localhost:5173

# Google OAuth — from Google Cloud Console > APIs & Services > Credentials
# Create an OAuth 2.0 Client ID (Web application), add http://localhost:5173 as an
# Authorized JavaScript Origin and http://localhost:5173 as an Authorized redirect URI.
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
